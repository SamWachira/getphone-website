# Getphone Temporary Bundle Provisioning - Environment Variables
# Copy this to .env for local development. NEVER commit real secrets.

# Database connection string
DATABASE_URL=postgresql://getphone_app:YOUR_PASSWORD@localhost:5432/getphone_bundles

# Topup API (Hormuud & Somnet)
TOPUP_API_BASE_URL=https://opsapi.hormuud.com/api/v1
TOPUP_API_USERNAME=getphone
TOPUP_API_PASSWORD=your_topup_api_password
HORMUUD_TOPUP_AMOUNT=0.20
SOMNET_TOPUP_AMOUNT=0.20

# Scheduling
SAFETY_GUARD_HOURS=6
TIMEZONE=Africa/Mogadishu

# Scheduler endpoint protection
SCHEDULER_SECRET=generate_a_strong_random_secret_here

# CORS origins (comma-separated list of allowed frontend domains)
CORS_ORIGINS=https://getphone-website.web.app,https://getphone-website.firebaseapp.com
